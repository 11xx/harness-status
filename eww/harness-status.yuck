(deflisten harness-status-codex-spinner
  :initial "⠋"
  `while :; do for frame in ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏; do printf '%s\\n' "$frame"; sleep 0.08; done; done`)

(deflisten harness-status-claude-spinner
  :initial "·"
  `while :; do for frame in · ✢ '*' ✶ ✻ ✽ ✽ ✻ ✶ '*' ✢ ·; do printf '%s\\n' "$frame"; sleep 0.30; done; done`)

(deflisten harness-status-pi-spinner
  :initial "π"
  `while :; do for frame in π ϖ π ℼ; do printf '%s\\n' "$frame"; sleep 0.48; done; done`)

(deflisten harness-status-codex-json
  :initial "{\"threads\":[]}"
  "harness-status codex --follow")

(deflisten harness-status-claude-json
  :initial "{\"threads\":[]}"
  "harness-status claude --follow")

(deflisten harness-status-pi-json
  :initial "{\"threads\":[]}"
  "harness-status pi --follow")

;; Account windows arrive through normal client activity. One daemon-wide poll
;; reads those local observations for every widget that renders them.
(defpoll harness-usage-json
  :interval "30m"
  :initial "{\"updated_at\":0,\"state\":\"unavailable\",\"codex\":{\"state\":\"unavailable\"},\"claude\":{\"state\":\"unavailable\"}}"
  "harness-status usage")

;; One thread of one harness. A running thread shows the harness spinner, a
;; settled one shows `glyph`, and one that wants the user shows why.
(defwidget harness-status-thread [thread spinner glyph]
  (box
    :class "harness-status__thread"
    :space-evenly false
    (button
      :class "harness-status__indicator harness-status__indicator--${thread.harness} harness-status__indicator--${thread.state} harness-status__indicator--reason-${thread?.reason ?: "none"}"
      :tooltip "${thread.harness}: ${thread.name} · ${thread.state == "attention" ? (thread?.reason ?: "attention") : thread.state} · ${thread?.model ?: "unknown model"} · ${thread.duration}"
      :onclick "harness-status ack '${thread.id}'"
      {thread.state == "working" ? spinner :
       thread.state == "attention" ? (thread?.reason == "failure" ? "×" : "!") :
       glyph})
    (label
      :class "harness-status__background"
      :visible {thread?.background ?: false}
      :tooltip "own work still running"
      :text "⋯")))

(defwidget harness-status-codex []
  (box
    :class "harness-status harness-status--codex"
    :space-evenly false
    (label :visible false :text "${harness-status-codex-spinner}")
    (for thread in {harness-status-codex-json.threads}
      (harness-status-thread
        :thread thread
        :spinner harness-status-codex-spinner
        :glyph "•"))))

(defwidget harness-status-claude []
  (box
    :class "harness-status harness-status--claude"
    :space-evenly false
    (label :visible false :text "${harness-status-claude-spinner}")
    (for thread in {harness-status-claude-json.threads}
      (harness-status-thread
        :thread thread
        :spinner harness-status-claude-spinner
        :glyph "✻"))))

(defwidget harness-status-pi []
  (box
    :class "harness-status harness-status--pi"
    :space-evenly false
    (label :visible false :text "${harness-status-pi-spinner}")
    (for thread in {harness-status-pi-json.threads}
      (harness-status-thread
        :thread thread
        :spinner harness-status-pi-spinner
        :glyph "π"))))

(defwidget harness-usage-provider [provider glyph]
  (label
    :class "harness-usage__provider harness-usage__provider--${provider.state}"
    :tooltip "${glyph == "C" ? "Codex" : "Claude"}: ${provider.state} · 5h ${provider?.five_hour?.used_percentage ?: "?"}% · 7d ${provider?.seven_day?.used_percentage ?: "?"}% · as of ${provider?.age_minutes ?: "?"}m ago"
    :text "${provider.state == "stale" ? "~" : ""}${glyph} ${provider?.five_hour?.used_percentage ?: "?"}/${provider?.seven_day?.used_percentage ?: "?"}%"))

(defwidget harness-usage []
  (box
    :class "harness-usage harness-usage--${harness-usage-json.state}"
    :space-evenly false
    :spacing 5
    (harness-usage-provider :provider {harness-usage-json.codex} :glyph "C")
    (harness-usage-provider :provider {harness-usage-json.claude} :glyph "✻")))
