(deflisten codex-spinner
  :initial "⠋"
  `while :; do for frame in ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏; do printf '%s\\n' "$frame"; sleep 0.08; done; done`)

(deflisten harness-status-json
  :initial "{\"threads\":[]}"
  "harness-status codex --follow")

(defwidget harness-indicators []
  (box
    :class "harness-indicators"
    :space-evenly false
    (label :visible false :text "${codex-spinner}")
    (for thread in {harness-status-json.threads}
      (button
        :class "harness-indicator ${thread.state}"
        :tooltip "${thread.harness}: ${thread.name} - ${thread.state}"
        :onclick "harness-status ack '${thread.id}'"
        {thread.state == "working" ? codex-spinner : "✓"}))))
